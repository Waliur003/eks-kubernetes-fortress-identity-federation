{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "FortressS3BucketReadAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::fortress-secure-assets-bucket",
                "arn:aws:s3:::fortress-secure-assets-bucket/*"
            ]
        }
    ]
}